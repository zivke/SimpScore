<resources>
    <!-- Score screen for rectangular watches (venusq2, venux1, ...). Same
         elements as the base layout, nudged for the taller-than-wide screen. -->
    <drawable-list id="backdrop" background="Graphics.COLOR_WHITE">
        <shape type="rectangle" x="0" y="0" width="100%" height="12%" color="Graphics.COLOR_BLACK" />
    </drawable-list>
    <layouts>
        <layout id="MainLayout">
            <drawable id="backdrop" />

            <label id="ClockLabel" text="XX:XX" x="50%" y="6%" color="Graphics.COLOR_WHITE"
                font="Graphics.FONT_XTINY"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="WinScoreTextLabel" text="@Strings.label_win_target" x="50%" y="19%"
                color="Graphics.COLOR_BLACK" font="Graphics.FONT_XTINY"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="ScoreToWinValueLabel" text="21" x="50%" y="28%"
                font="Graphics.FONT_NUMBER_MILD" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="HomeScoreTextLabel" text="@Strings.label_home" x="24%" y="46%"
                font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="HomeScoreValueLabel" text="00" x="24%" y="66%"
                font="Graphics.FONT_NUMBER_MEDIUM" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="AwayScoreTextLabel" text="@Strings.label_away" x="76%" y="46%"
                font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="AwayScoreValueLabel" text="00" x="76%" y="66%"
                font="Graphics.FONT_NUMBER_MEDIUM" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
        </layout>
    </layouts>
</resources>
