<resources>
    <!-- Score screen for the smaller semi-octagon Instincts (instinct2s 163x156,
         instincte40mm 166x166). Mirrors resources-semioctagon-176x176/ scaled
         down: top clock band, the win score in the physical sub-screen circle,
         HOME / AWAY columns. The 176x176 folder wins for the larger Instincts. -->
    <drawable-list id="backdrop" background="Graphics.COLOR_WHITE">
        <shape type="circle" x="133" y="28" radius="32" color="Graphics.COLOR_BLACK" />
        <shape type="rectangle" x="0" y="0" width="100%" height="24" color="Graphics.COLOR_BLACK" />
    </drawable-list>
    <layouts>
        <layout id="MainLayout">
            <drawable id="backdrop" />

            <label id="ClockLabel" text="XX:XX" x="45%" y="11" color="Graphics.COLOR_WHITE"
                font="Graphics.FONT_XTINY"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="ScoreToWinValueLabel" text="21" x="133" y="28"
                font="Graphics.FONT_NUMBER_MILD" color="Graphics.COLOR_WHITE"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="HomeScoreTextLabel" text="@Strings.label_home" x="30%" y="82"
                font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="HomeScoreValueLabel" text="00" x="30%" y="120"
                font="Graphics.FONT_NUMBER_THAI_HOT" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="AwayScoreTextLabel" text="@Strings.label_away" x="70%" y="82"
                font="Graphics.FONT_TINY" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="AwayScoreValueLabel" text="00" x="70%" y="120"
                font="Graphics.FONT_NUMBER_THAI_HOT" color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
        </layout>
    </layouts>
</resources>
