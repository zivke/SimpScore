<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <string id="AppName">SimpScore</string>

    <string id="label_home">HOME</string>
    <string id="label_away">AWAY</string>

    <!-- Static caption above the win-score number on screens with no sub-screen
         (round, rectangle). The Instinct layout uses its sub-screen circle
         instead and does not show this. -->
    <string id="label_win_target">WIN</string>

    <string id="menu_new_game">New Game</string>
    <string id="menu_win_score">Win Score</string>
    <string id="menu_win_score_off">Off</string>
    <string id="menu_win_by_2">Win by 2</string>

    <!-- Shown in the target circle on the score screen when no win score is set. -->
    <string id="win_score_off_indicator">-</string>

    <!-- On-screen confirm button on the win-score entry screen, touchscreen
         devices only (they have no physical select button). -->
    <string id="button_ok">OK</string>
