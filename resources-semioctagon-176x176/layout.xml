<resources>
    <!-- The Instinct 2 subscreen is a 62x62 circle centred at (144, 31).
         Keep the win-score backdrop and digits well inside its rim. -->
    <drawable-list id="backdrop" background="Graphics.COLOR_WHITE">
        <shape type="circle" x="144" y="31" radius="31" color="Graphics.COLOR_BLACK" />
    </drawable-list>
    <layouts>
        <layout id="MainLayout">
            <drawable id="backdrop" />

            <label id="ClockLabel" text="00:00" x="72" y="6" font="Graphics.FONT_TINY"
                color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER" />

            <label id="ScoreToWinValueLabel" text="21" x="144" y="31"
                font="Graphics.FONT_NUMBER_MILD"
                color="Graphics.COLOR_WHITE"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="HomeScoreTextLabel" text="HOME" x="54" y="90" font="Graphics.FONT_TINY"
                color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="HomeScoreValueLabel" text="00" x="54" y="130"
                font="Graphics.FONT_NUMBER_THAI_HOT"
                color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />

            <label id="AwayScoreTextLabel" text="AWAY" x="120" y="90" font="Graphics.FONT_TINY"
                color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
            <label id="AwayScoreValueLabel" text="00" x="120" y="130"
                font="Graphics.FONT_NUMBER_THAI_HOT"
                color="Graphics.COLOR_BLACK"
                justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER" />
        </layout>
    </layouts>
</resources>
